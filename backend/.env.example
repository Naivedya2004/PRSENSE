# Copy to backend/.env for local development. Placeholder values only; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=prsense
DB_USER=postgres
DB_PASSWORD=replace_me
DB_HOST=localhost
DB_PORT=5432

# Production-only switches (defaults are safe for local development).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# GitHub App (user-to-server OAuth). Create the App in GitHub settings; see README.
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/callback/
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_API_VERSION=2026-03-10
GITHUB_HTTP_TIMEOUT_SECONDS=10
GITHUB_PR_SYNC_MAX_PAGES=10

# Frontend origin used for post-OAuth redirects (public, not a secret).
FRONTEND_URL=http://localhost:5173

# Fernet key that encrypts GitHub tokens in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_me
